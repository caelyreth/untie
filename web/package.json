{
  "name": "untie-web",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun run wasm && vite dev",
    "build": "bun run wasm && vite build",
    "preview": "vite preview",
    "wasm": "bun scripts/build-wasm.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "@comark/svelte": "^0.6.2",
    "@lucide/svelte": "^1.67.0",
    "comark": "^0.6.2",
    "rangi": "^2.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "packageManager": "bun@1.4.2"
}
