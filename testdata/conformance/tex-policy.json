    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/top-level-alignment"],
      "codes": ["unexpected-token"],
      "reason": "alignment tabs are only legal inside supported environments"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/missing-right"],
      "codes": ["unclosed-group"],
      "reason": "an unmatched left delimiter is rejected"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/missing-color-brace"],
      "codes": ["invalid-value"],
      "reason": "the color argument is syntactically invalid"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/invalid-size-unit"],
