    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/mismatched-environment"],
      "codes": ["invalid-environment"],
      "reason": "begin and end environment names must match"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/math-function-in-text"],
      "codes": ["unsupported"],
      "reason": "math functions inside text are explicitly unsupported"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/missing-argument-eof"],
      "codes": ["missing-argument"],
      "reason": "a command at end of input is missing its required argument"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/undefined-control-sequence"],
      "codes": ["unknown-command"],
      "reason": "undefined control sequences are parse errors"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/extra-close-brace"],
      "codes": ["unexpected-token"],
