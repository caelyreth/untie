{
  "schemaVersion": 1,
  "diagnosticExpectations": [
    {
      "corpus": "katex-cases",
      "ids": ["errors/repeated-infix"],
      "codes": ["unexpected-token"],
      "reason": "KaTeX rejects multiple infix operators in one group"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/conflicting-infix"],
      "codes": ["unexpected-token"],
      "reason": "KaTeX rejects conflicting infix operators"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/missing-superscript-group"],
      "codes": ["missing-argument"],
      "reason": "KaTeX requires a group after a superscript marker"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/missing-subscript-group"],
      "codes": ["missing-argument"],
      "reason": "KaTeX requires a group after a subscript marker"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/sqrt-as-superscript"],
      "codes": ["missing-argument"],
      "reason": "KaTeX rejects a function without an argument in script position"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/limits-without-operator"],
      "codes": ["unexpected-token"],
      "reason": "limit controls must follow a math operator"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/limits-at-start"],
      "codes": ["unexpected-token"],
      "reason": "limit controls at the start have no preceding operator"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/double-superscript"],
      "codes": ["unexpected-token"],
      "reason": "KaTeX rejects a second superscript on one nucleus"
    },
    {
      "corpus": "katex-cases",
      "ids": ["errors/prime-double-superscript"],
      "codes": ["unexpected-token"],
