  "exclusions": [
    {
      "corpus": "ratex-core",
      "families": ["command:\\ce", "command:\\pu"],
      "codes": ["unsupported"],
      "reason": "Chemistry and unit markup are outside the neutral math IR and are explicitly rejected."
    },
    {
      "corpus": "ratex-core",
      "families": [
        "command:\\includegraphics",
        "command:\\htmlClass",
        "command:\\htmlData",
        "command:\\htmlId",
        "command:\\htmlStyle",
        "command:\\html@mathml"
      ],
      "codes": ["unsupported", "unknown-command"],
      "reason": "DOM, trust, raw HTML, and external image extensions are outside the neutral drawing IR."
    },
    {
      "corpus": "ratex-core",
      "families": [
        "command:\\llap",
        "command:\\rlap",
        "command:\\clap",
        "command:\\mathllap",
        "command:\\mathrlap",
        "command:\\mathclap",
        "command:\\raisebox",
        "command:\\vcenter",
        "command:\\smash",
        "command:\\phase",
        "command:\\enclose"
      ],
      "codes": ["unsupported", "unknown-command"],
      "reason": "Overlap, manual raise, and smash geometry have no lossless neutral IR representation yet."
    },
    {
      "corpus": "ratex-core",
      "families": ["environment:CD"],
      "codes": ["unsupported"],
      "reason": "Commutative-diagram environments are outside the neutral math IR and are explicitly rejected."
    },
    {
      "corpus": "ratex-core",
      "ids": ["line:000994"],
      "codes": ["unsupported"],
      "reason": "Row-scoped \\nonumber events inside alignment environments are deferred until multiline equation-tag metadata is implemented."
    },
    {
      "corpus": "ratex-core",
      "ids": ["line:000995"],
      "codes": ["unsupported"],
      "reason": "Row-scoped \\tag values inside alignment environments are deferred until multiline equation-tag metadata is implemented."
    },
    {
      "corpus": "ratex-core",
      "families": [
        "command:\\tiny",
        "command:\\sixptsize",
        "command:\\scriptsize",
        "command:\\footnotesize",
        "command:\\small",
        "command:\\normalsize",
        "command:\\large",
        "command:\\Large",
        "command:\\LARGE",
        "command:\\huge",
        "command:\\Huge"
      ],
      "codes": ["unsupported"],
      "reason": "Math font-size declarations require a neutral KaTeX-compatible size index that is not yet represented in the IR."
    }
  ],
  "knownGaps": []
}
